{
  "appId": "com.hostelflow.tickets",
  "appName": "Hostel Ticket System",
  "webDir": "www",
  "bundledWebRuntime": false,
  "server": {
    "url": "http://10.0.2.2:4000",
    "cleartext": true,
    "androidScheme": "https",
    "allowNavigation": [
      "10.0.2.2",
      "localhost",
      "127.0.0.1",
      "*.example.com"
    ]
  },
  "plugins": {
    "SplashScreen": {
      "launchShowDuration": 1500,
      "launchAutoHide": true,
      "backgroundColor": "#0f172a",
      "androidSplashResourceName": "splash",
      "androidScaleType": "CENTER_CROP",
      "showSpinner": false
    },
    "StatusBar": {
      "style": "DARK",
      "backgroundColor": "#0f172a"
    }
  }
}
